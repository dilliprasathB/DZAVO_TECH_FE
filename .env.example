# WhatsApp Official Number (Country code + phone without symbols)
# Example: 918610140943 for +91 8610140943
VITE_WHATSAPP_NUMBER=918610140943

# Company Contact Details
VITE_CONTACT_EMAIL=dilliprasath1225@gmail.com
VITE_CONTACT_PHONE=+91 8610140943
VITE_COMPANY_ADDRESS=Chennai, Tamil Nadu, India

# Supabase Integration (Optional for direct PostgreSQL / Supabase client)
